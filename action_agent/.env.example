# ============================================================================
# ACTION AGENT ENVIRONMENT CONFIGURATION
# ============================================================================

# OpenAI API Key (Optional for offline/mock test runner, required for live GPT-4o parsing)
OPENAI_API_KEY=your-openai-api-key-here
MODEL_NAME=gpt-4o
TEMPERATURE=0.0

# Execution & Runtime Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
ENABLE_HITL=true
AUDIT_LOG_FILE=audit_log.jsonl

# Operational Timeouts & Latency Simulation
TOOL_TIMEOUT_SECONDS=30
MOCK_TOOL_DELAY_SECONDS=0.2
HITL_INPUT_TIMEOUT_SECONDS=120
