# =============================================================================
# Action Agent Configuration
# =============================================================================
# Copy this file to .env and adjust values as needed.

# Execution mode: DRY_RUN (default, safe) or LIVE
EXECUTION_MODE=DRY_RUN

# Database path (SQLite file)
DATABASE_PATH=action_agent.db

# Server settings
HOST=0.0.0.0
PORT=8000

# =============================================================================
# Policy Engine Thresholds
# =============================================================================

# Minimum confidence score to execute (0.0 - 1.0)
MIN_CONFIDENCE_LOW_RISK=0.5
MIN_CONFIDENCE_MEDIUM_RISK=0.7
MIN_CONFIDENCE_HIGH_RISK=0.85

# Maximum rollout percentage per risk level
MAX_ROLLOUT_LOW_RISK=100
MAX_ROLLOUT_MEDIUM_RISK=50
MAX_ROLLOUT_HIGH_RISK=20

# Recommendation TTL in hours (reject expired recommendations)
RECOMMENDATION_TTL_HOURS=24

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO
